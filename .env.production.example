POSTGRES_USER=forgesight
POSTGRES_PASSWORD=replace-with-managed-db-password
POSTGRES_DB=forgesight

DATABASE_URL=postgresql://forgesight:replace-with-managed-db-password@postgres:5432/forgesight
REDIS_URL=redis://redis:6379/0
MLFLOW_TRACKING_URI=http://mlflow:5000
MLFLOW_MODEL_NAME=forgesight-inspection-model
MLFLOW_MODEL_STAGE=Production
MEDIA_ROOT=/app/storage
MAX_UPLOAD_SIZE=10485760
MAX_IMAGE_DIM=10000

SECRET_KEY=replace-with-at-least-32-random-bytes
ACCESS_TOKEN_EXPIRE_MINUTES=1440
CORS_ORIGINS=https://replace-with-your-web-origin.example

VITE_API_URL=/api/v1
